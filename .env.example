# FastAPI data mode: demo or real.
SKILLWORTH_DATA_MODE=demo

# Used only when SKILLWORTH_DATA_MODE=real.
SKILLWORTH_REAL_MODE_MANIFEST=data/modes/freehire/current.json

# Next.js server-side proxy target.
SKILLWORTH_API_URL=http://127.0.0.1:8011

# Optional Playwright overrides.
SKILLWORTH_E2E_API_PORT=18011
SKILLWORTH_E2E_WEB_PORT=13001
