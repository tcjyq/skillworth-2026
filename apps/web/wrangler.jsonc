{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skillworth-2026",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/worker.ts",
  "workers_dev": true,
  "routes": [
    { "pattern": "skillworth.tcjyq.cc", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/backend-api/*",
      "/backend-data/*"
    ]
  },
  "cache": {
    "enabled": true
  }
}
